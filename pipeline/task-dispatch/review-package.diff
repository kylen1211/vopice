+# `[openclaw-exec] terminal-report ...` log line (§0.9 播报措辞不做语义比对,
+# 只要求"内容与该任务相关" — this file doesn't assert semantic content for
+# that reason, matching contract's own "播报措辞不做语义比对" callout).
+# Also carries C-09 步骤4's negative half structurally (not this file's job:
+# the pytest side of C-09 asserts `tasks show` call count == 0 on this same
+# return-flow path — see server/tests/, T-6).
+
+turns:
+  # Absorb the on_client_ready greeting turn before sending the real
+  # question (see smoke.yaml — sending user text as turn 0 risks an
+  # interruption that corrupts context, reproduced 20260801).
+  - expect:
+      - event: response
+
+  - user: "帮我在后台写一份大约200字的说明，介绍一下光合作用的基本原理，写完不用现在念给我听。"
+    expect:
+      - event: function_call
+        calls:
+          - name: dispatch_task
+      - event: response
+
+  # No `user:` here — this turn just waits for the exec worker's real
+  # OpenClaw run to finish and its terminal message to come back through
+  # the injection queue (§0.9), triggering a second, unprompted fast-brain
+  # response. within_ms is generous relative to the measured ~6-10s
+  # dispatch-to-terminal-event round trip (see header) plus LLM turn
+  # latency — see backend-notes.md for the actual measured run time.
+  - expect:
+      - event: response
+        within_ms: 90000
