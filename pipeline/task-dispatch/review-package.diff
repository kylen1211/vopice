@@ -20,6 +20,9 @@ _FAKE_REQUIRED_ENV = {
     "LLM_API_KEY": "sk-test-key",
     "LLM_MODEL": "gemini-3.6-flash-high",
     "SLOW_LLM_MODEL": "gemini-3-pro",
+    # task-dispatch (C4 派活) T-5 新增必需项（server/config.py §0.6）——T-6 交接缝隙
