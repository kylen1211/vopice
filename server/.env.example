# voice-agent - Environment Variables
# Copy this file to .env and fill in your real values

# ============================================================
# 必需项（8 项，config.py load_config() 启动时校验，缺一即拒绝启动）
# fast-slow-brain design §6.2：1 期 5 项换成新 8 项——
# 1 期 Whisper/Kokoro 遗留的两个模型档位项已删除（被 Soniox/ElevenLabs 取代），
# 新增快慢脑双档 LLM + Soniox STT + ElevenLabs TTS。
# task-dispatch (C4 派活) design.md 方案 C / 契约 §0.6：新增 OPENCLAW_AGENT_ID。
# scenario-assembly M-1（expand-contract）：SLOW_LLM_MODEL 从"恒定必需"改为
# "仅 DUAL_BRAIN_ENABLED 开启时必需"，移出本节（见下方慢脑开关小节），
# 9 项换回新 8 项。
# ============================================================

# 快脑 LLM — 指向本地/远程网关（design U2 / §6.2）
LLM_BASE_URL=CHANGE_ME_LLM_BASE_URL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=CHANGE_ME_LLM_MODEL

# Soniox（STT）
SONIOX_API_KEY=CHANGE_ME_SONIOX_API_KEY

# ElevenLabs（TTS，默认厂商，见下方 TTS_PROVIDER）
ELEVENLABS_API_KEY=CHANGE_ME_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=CHANGE_ME_ELEVENLABS_VOICE_ID
# design §6.2 推荐值：eleven_flash_v2_5（官方多语白名单内、可显式传 language 的固定选型）。
ELEVENLABS_MODEL=CHANGE_ME_ELEVENLABS_MODEL

# 派活（C4 task-dispatch）— OpenClaw agent id，派活会话键模板
# `agent:{agent_id}:voice-agent-{token}`（契约 §0.6）的 agent_id 段。
# 本机可选值实测为 main / dev（`openclaw agents list --json`）。
OPENCLAW_AGENT_ID=CHANGE_ME_OPENCLAW_AGENT_ID

# ============================================================
# 慢脑（深度分析）开关（scenario-assembly ADR-6，FR-12）
# ============================================================

# 默认关闭。真值集 {1,true,yes,on}/假值集 {0,false,no,off,空}（大小写不敏感），
# 集合外的取值会启动即报错，不静默当假。
DUAL_BRAIN_ENABLED=false

# 慢脑 LLM — design §6.2：故意选慢档，用于拉开快慢脑时间差，可按需替换其他型号。
# 推荐值 gemini-3-pro（非占位符，RTM 会 grep 断言 .env.example 含此值）。
# scenario-assembly M-1：仅当 DUAL_BRAIN_ENABLED=true 时必需；关闭态下即使
# 留着这一行也不报错、不使用（防"删了才不报错"的伪迁移）。
SLOW_LLM_MODEL=gemini-3-pro

# ============================================================
# 场景模板（scenario-assembly FR-1/FR-6/FR-2）
# ============================================================

# 合法值 = server/scenarios.py::TEMPLATES 的 key：voice_chat（默认）/
# english_tutor。模板声明的 stt_provider/tts_provider/tts_voice/tts_model 等
# services 覆盖会**覆盖**下方 STT_PROVIDER/TTS_PROVIDER 等环境变量（ADR-5
# 优先级：模板 > 环境变量 > 内置默认）——例如 english_tutor 固定用
# assemblyai，此时这里设置的 STT_PROVIDER 不会生效。
# SCENARIO=voice_chat

# ============================================================
# 按 provider 选择性必需项（2026-08-03 新增备用厂商；只在把下方 STT_PROVIDER/
# TTS_PROVIDER 切成对应厂商、或所选 SCENARIO 模板声明了对应厂商时才必需，
# config.py load_config() 按生效 provider 条件校验。用默认组合
# （soniox+elevenlabs，SCENARIO=voice_chat）不需要配下面这些，可以留空/删掉。）
# ============================================================

# STT_PROVIDER=deepgram 时必需
# DEEPGRAM_API_KEY=CHANGE_ME_DEEPGRAM_API_KEY

# TTS_PROVIDER=cartesia 时必需
# CARTESIA_API_KEY=CHANGE_ME_CARTESIA_API_KEY
# CARTESIA_VOICE_ID=CHANGE_ME_CARTESIA_VOICE_ID

# 生效 STT provider = assemblyai 时必需（scenario-assembly M-6，修订 R2）——
# SCENARIO=english_tutor 模板默认选中它（universal-3-5-pro 原生中英
# code-switch，解开陪练场景的语言轴）；未选中它的用户不必配这项。
# ASSEMBLYAI_API_KEY=CHANGE_ME_assemblyai_api_key

# ============================================================
# 非必需项（有默认值，不设置就用默认值；设置了会做白名单/取值校验）
# ============================================================

# STT provider 白名单 — 2026-08-10 起支持 soniox（默认）/ deepgram /
# assemblyai（scenario-assembly M-6）。
# STT_PROVIDER=soniox

# TTS provider 白名单 — 2026-08-03 起支持 elevenlabs（默认）/ cartesia。
# TTS_PROVIDER=elevenlabs

# Soniox 模型档位 — 不设置默认 stt-rt-v5（沿用旧库在用型号，design §13.1）。
# SONIOX_MODEL=stt-rt-v5
