# voice-agent - Environment Variables
# Copy this file to .env and fill in your real values

# LLM — 1 期指向本地网关（design U2 / §6.2）
LLM_BASE_URL=CHANGE_ME_LLM_BASE_URL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=CHANGE_ME_LLM_MODEL

# Whisper (STT) — 本地模型，无需 API key；这里只是模型档位。config.py 会校验
# （门三 20260801 REQ-001 补），留空/占位值启动即拒绝。合法值见 faster-whisper：
# tiny/base/small/medium/large(-v1/v2/v3)/turbo 等。
OPENAI_MODEL=CHANGE_ME_OPENAI_MODEL

# Kokoro (TTS) — 本地模型，无需 API key，只需选音色；同上，config.py 已校验。
KOKORO_VOICE_ID=CHANGE_ME_KOKORO_VOICE_ID
