# voice-agent - Environment Variables
# Copy this file to .env and fill in your real values

# ============================================================
# 必需项（8 项，config.py load_config() 启动时校验，缺一即拒绝启动）
# fast-slow-brain design §6.2：1 期 5 项换成新 8 项——
# 1 期 Whisper/Kokoro 遗留的两个模型档位项已删除（被 Soniox/ElevenLabs 取代），
# 新增快慢脑双档 LLM + Soniox STT + ElevenLabs TTS。
# ============================================================

# 快脑 LLM — 指向本地/远程网关（design U2 / §6.2）
LLM_BASE_URL=CHANGE_ME_LLM_BASE_URL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=CHANGE_ME_LLM_MODEL

# 慢脑 LLM — design §6.2：故意选慢档，用于拉开快慢脑时间差，可按需替换其他型号。
# 推荐值 gemini-3-pro（非占位符，RTM 会 grep 断言 .env.example 含此值）。
SLOW_LLM_MODEL=gemini-3-pro

# Soniox（STT）
SONIOX_API_KEY=CHANGE_ME_SONIOX_API_KEY

# ElevenLabs（TTS）
ELEVENLABS_API_KEY=CHANGE_ME_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=CHANGE_ME_ELEVENLABS_VOICE_ID
# design §6.2 推荐值：eleven_flash_v2_5（官方多语白名单内、可显式传 language 的固定选型）。
ELEVENLABS_MODEL=CHANGE_ME_ELEVENLABS_MODEL

# ============================================================
# 非必需项（有默认值，不设置就用默认值；设置了会做白名单/取值校验）
# ============================================================

# STT provider 白名单 — design §6.3：当前仅支持 soniox。不设置默认 soniox。
# STT_PROVIDER=soniox

# TTS provider 白名单 — design §6.3：当前仅支持 elevenlabs。不设置默认 elevenlabs。
# TTS_PROVIDER=elevenlabs

# Soniox 模型档位 — 不设置默认 stt-rt-v5（沿用旧库在用型号，design §13.1）。
# SONIOX_MODEL=stt-rt-v5
